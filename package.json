{
  "name": "@haneoka/cassiopeia-plugin-sonolus",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/cassiopeia-plugin-sonolus.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "build:engine": "pnpm --filter @haneoka/cassiopeia-sonolus-engine build",
    "effects:serve": "node scripts/effects/serve.mjs"
  },
  "peerDependencies": {
    "@haneoka/cassiopeia": "^0.1.0",
    "@haneoka/cassiopeia-plugin-our-notes": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "three": "0.184.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.14.0",
  "dependencies": {
    "@sonolus/core": "7.15.3"
  },
  "description": "Sonolus chart conversion, engine targets and effect capture for Cassiopeia"
}
